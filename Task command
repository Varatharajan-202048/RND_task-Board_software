function renderStats(){
  var total=TASKS.length;
  var wip=TASKS.filter(function(t){return t.status==='wip'}).length;
  var done=TASKS.filter(function(t){return t.status==='done'}).length;
  var overdue=TASKS.filter(function(t){return t.status!=='done'&&t.deadline&&t.deadline<today}).length;
  var blocked=TASKS.filter(function(t){return t.status==='blocked'}).length;
  var pct=total?Math.round(done/total*100):0;
  document.getElementById('stats-grid').innerHTML=
    statCard('accent',total,'Total tasks','Across all departments')+
    statCard('amber',wip,'In progress','Active right now')+
    statCard('green',done,'Completed',pct+'% completion rate')+
    statCard('red',overdue,'Overdue','Needs immediate attention')+
    statCard('purple',blocked,'Blocked','Waiting on dependencies');
  document.getElementById('nb-overdue').textContent=overdue||'';
  document.getElementById('nb-overdue').style.display=overdue?'':'none';
}

function statCard(cls,val,label,sub){
  return '<div class="stat-card '+cls+'">'
    +'<div class="stat-label">'+esc(label)+'</div>'
    +'<div class="stat-value">'+val+'</div>'
    +'<div class="stat-sub">'+esc(sub)+'</div>'
    +'</div>';
}

