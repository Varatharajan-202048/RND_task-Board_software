// ── UTILS ─────────────────────────────────────────────────────────────────────
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}
function getMember(id){return MEMBERS.find(function(m){return m.id===id})||{name:'Unknown',dept:'—',role:'—'}}
function getTasks(){
  var df=document.getElementById('dept-filter').value;
  var pf=document.getElementById('prio-filter').value;
  var sf=document.getElementById('status-filter').value;
  var gs=document.getElementById('global-search').value.toLowerCase().trim();
  return TASKS.filter(function(t){
    var m=getMember(t.memberId);
    if(df && t.dept!==df) return false;
    if(pf && t.prio!==pf) return false;
    if(sf && t.status!==sf) return false;
    if(gs && !(t.title.toLowerCase().includes(gs)||m.name.toLowerCase().includes(gs)||t.dept.toLowerCase().includes(gs))) return false;
    return true;
  });
}

function dlClass(dl,status){
  if(!dl) return 'dl-ok';
  if(status==='done') return 'dl-ok';
  if(dl < today) return 'dl-over';
  var d=new Date(dl),t=new Date();
  var diff=(d-t)/(1000*60*60*24);
  return diff<=2 ? 'dl-warn' : 'dl-ok';
}

function statusBadge(s){
  var labels={todo:'To do',wip:'In progress',review:'In review',done:'Done',blocked:'Blocked'};
  var dots={todo:'dot-todo',wip:'dot-wip',review:'dot-review',done:'dot-done',blocked:'dot-blocked'};
  return '<span class="badge badge-'+s+'"><span class="dot '+dots[s]+'"></span>'+esc(labels[s]||s)+'</span>';
}

function prioBadge(p){
  return '<span class="badge badge-'+p.toLowerCase()+'">'+esc(p)+'</span>';
}

function progBar(pct,color){
  color=color||'var(--accent)';
  return '<div class="prog-wrap"><div class="prog-bar"><div class="prog-fill" style="width:'+pct+'%;background:'+color+'"></div></div><span class="prog-label">'+pct+'%</span></div>';
}

