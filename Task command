    var dm=MEMBERS.filter(function(m){return m.dept===dept});
    var col=DEPT_COLORS[dept]||'#6B7280';
    var rows=dt.map(function(t){
      var m=getMember(t.memberId);
      var c=avColor(t.memberId);
      return '<tr>'
        +'<td><div class="person-cell"><div class="avatar avatar-sm" style="background:'+c.bg+';color:'+c.fg+'">'+initials(m.name)+'</div><div class="person-name" style="font-size:12px">'+esc(m.name)+'</div></div></td>'
        +'<td style="font-size:13px;font-weight:500">'+esc(t.title)+'</td>'
        +'<td>'+statusBadge(t.status)+'</td>'
        +'<td>'+prioBadge(t.prio)+'</td>'
        +'<td><span class="dl mono '+dlClass(t.deadline,t.status)+'">'+esc(t.deadline||'—')+'</span></td>'
        +'<td>'+progBar(t.progress)+'</td>'
        +'<td><button class="btn btn-ghost btn-sm" onclick="openEditTask('+t.id+')">Edit</button></td>'
        +'</tr>';
    }).join('');
    var empty=dt.length?'':'<tr><td colspan="7"><div class="empty-state" style="padding:16px"><div class="empty-text">No tasks yet</div></div></td></tr>';
    return '<div class="table-wrap" style="margin-bottom:20px">'
      +'<div class="table-toolbar">'
      +'<span style="font-size:14px;font-weight:600;color:'+col+'">'+esc(dept)+'</span>'
      +'<span style="font-size:12px;color:var(--muted);margin-left:4px">'+dm.length+' members · '+dt.length+' tasks</span>'
      +'<span style="flex:1"></span>'
      +'<div style="display:flex;gap:4px">'+dm.slice(0,8).map(function(m){var c=avColor(m.id);return '<div class="avatar avatar-sm" style="background:'+c.bg+';color:'+c.fg+';border:1.5px solid var(--surface2)" title="'+esc(m.name)+'">'+initials(m.name)+'</div>'}).join('')+'</div>'
      +'</div>'
      +'<table><thead><tr><th>Person</th><th>Task</th><th>Status</th><th>Priority</th><th>Deadline</th><th>Progress</th><th></th></tr></thead>'
      +'<tbody>'+rows+empty+'</tbody></table></div>';
  }).join('');
}

// ── UPLOADS VIEW ─────────────────────────────────────────────────────────────
function renderUploads(){
  var el=document.getElementById('uploads-tbody');
  var withFiles=TASKS.filter(function(t){return t.files&&t.files.length});
  if(!withFiles.length){
    el.innerHTML='<tr><td colspan="5"><div class="empty-state"><div class="empty-icon">📂</div><div class="empty-text">No files submitted yet. Team members can attach files when completing tasks.</div></div></td></tr>';
    return;
  }
  var rows=[];
  withFiles.forEach(function(t){
    var m=getMember(t.memberId);
    var c=avColor(t.memberId);
    t.files.forEach(function(f){
      rows.push('<tr>'
        +'<td><div class="person-cell"><div class="avatar avatar-sm" style="background:'+c.bg+';color:'+c.fg+'">'+initials(m.name)+'</div><div class="person-name">'+esc(m.name)+'</div></div></td>'
        +'<td style="font-size:13px">'+esc(t.title)+'</td>'
        +'<td><span class="attach-chip">📎 '+esc(f)+'</span></td>'
        +'<td>'+statusBadge(t.status)+'</td>'
        +'<td class="mono" style="font-size:12px;color:var(--muted)">'+esc(t.deadline||'—')+'</td>'
        +'</tr>');
    });
  });
  el.innerHTML=rows.join('');
}

// ── MODAL: ADD / EDIT TASK ────────────────────────────────────────────────────
function populateSelects(){
  var ms=document.getElementById('f-member');
  var mdd=document.getElementById('new-dept');
  ms.innerHTML=MEMBERS.map(function(m){
    return '<option value="'+m.id+'">'+esc(m.name)+' ('+esc(m.dept)+')</option>';
  }).join('');
  var ds=document.getElementById('f-dept');
  ds.innerHTML=DEPTS.map(function(d){return '<option>'+esc(d)+'</option>'}).join('');
  mdd.innerHTML=DEPTS.map(function(d){return '<option>'+esc(d)+'</option>'}).join('');
  var df=document.getElementById('dept-filter');
  df.innerHTML='<option value="">All departments</option>'+DEPTS.map(function(d){return '<option>'+esc(d)+'</option>'}).join('');
}

function openAddTask(){
  editId=null;pendingFiles=[];
  document.getElementById('modal-task-title').textContent='New task';
  document.getElementById('f-title').value='';
  document.getElementById('f-prio').value='Medium';
  document.getElementById('f-status').value='todo';
  document.getElementById('f-deadline').value='';
  document.getElementById('f-progress').value='0';
  document.getElementById('f-notes').value='';
  document.getElementById('file-chips').innerHTML='';
  document.getElementById('del-btn').style.display='none';
  populateSelects();
  document.getElementById('modal-task').classList.add('open');
}

function openEditTask(id){
  var t=TASKS.find(function(x){return x.id===id});if(!t)return;
  editId=id;pendingFiles=t.files?t.files.slice():[];
  document.getElementById('modal-task-title').textContent='Edit task';
  populateSelects();
  document.getElementById('f-title').value=t.title;
  document.getElementById('f-member').value=t.memberId;
  document.getElementById('f-dept').value=t.dept;
  document.getElementById('f-prio').value=t.prio;
  document.getElementById('f-status').value=t.status;
  document.getElementById('f-deadline').value=t.deadline||'';
  document.getElementById('f-progress').value=t.progress||0;
  document.getElementById('f-notes').value=t.notes||'';
  document.getElementById('del-btn').style.display='';
  renderFileChips();
  document.getElementById('modal-task').classList.add('open');
}

function saveTask(){
  var title=document.getElementById('f-title').value.trim();
  if(!title){toast('Please enter a task title');return;}
  var memberId=parseInt(document.getElementById('f-member').value);
  var m=getMember(memberId);
  var obj={
    id:editId||nextId++,
    title:title,
    memberId:memberId,
    dept:document.getElementById('f-dept').value||m.dept,
    prio:document.getElementById('f-prio').value,
    status:document.getElementById('f-status').value,
    deadline:document.getElementById('f-deadline').value||'',
    progress:Math.min(100,Math.max(0,parseInt(document.getElementById('f-progress').value)||0)),
    notes:document.getElementById('f-notes').value,
    files:pendingFiles.slice()
  };
  if(editId){var i=TASKS.findIndex(function(x){return x.id===editId});TASKS[i]=obj;}
  else TASKS.push(obj);
  closeModal('modal-task');
  renderAll();
  toast(editId?'Task updated':'Task created',true);
}

function deleteTask(){
  if(!editId)return;
  if(!confirm('Delete this task permanently?'))return;
  TASKS=TASKS.filter(function(t){return t.id!==editId});
  closeModal('modal-task');
  renderAll();
  toast('Task deleted');
}

function handleUpload(e){
  Array.from(e.target.files).forEach(function(f){pendingFiles.push(f.name)});
  renderFileChips();
}

function renderFileChips(){
  document.getElementById('file-chips').innerHTML=pendingFiles.map(function(f,i){
    return '<div class="file-chip">📎 '+esc(f)+'<button onclick="removeFile('+i+')" title="Remove">✕</button></div>';
  }).join('');
}

function removeFile(i){pendingFiles.splice(i,1);renderFileChips();}

// ── MODAL: MEMBERS ────────────────────────────────────────────────────────────
function openMembers(){
  populateSelects();
  renderMembersList();
  document.getElementById('new-name').value='';
  document.getElementById('modal-members').classList.add('open');
}

function addMember(){
  var n=document.getElementById('new-name').value.trim();
  var d=document.getElementById('new-dept').value;
  if(!n){toast('Enter a name');return;}
  if(MEMBERS.find(function(m){return m.name.toLowerCase()===n.toLowerCase()})){toast('Member already exists');return;}
  MEMBERS.push({id:nextMemberId++,name:n,dept:d,role:'Team Member'});
  document.getElementById('new-name').value='';
  renderMembersList();populateSelects();renderAll();
  toast('Member added',true);
}

function removeMember(id){
  var m=getMember(id);
  if(!confirm('Remove '+m.name+'? Their tasks will remain.'))return;
  var idx=MEMBERS.findIndex(function(x){return x.id===id});
  if(idx>-1) MEMBERS.splice(idx,1);
  renderMembersList();populateSelects();renderAll();
  toast('Member removed');
}

function renderMembersList(){
  var el=document.getElementById('members-list');
  el.innerHTML=MEMBERS.map(function(m){
    var c=avColor(m.id);
    var dc=DEPT_COLORS[m.dept]||'#6B7280';
    var mt=TASKS.filter(function(t){return t.memberId===m.id}).length;
    return '<div class="member-row" style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border)">'
      +'<div class="avatar" style="background:'+c.bg+';color:'+c.fg+'">'+initials(m.name)+'</div>'
      +'<div style="flex:1">'
      +'<div style="font-size:13px;font-weight:500;color:var(--text)">'+esc(m.name)+'</div>'
      +'<div style="font-size:11px;color:'+dc+'">'+esc(m.dept)+'</div>'
      +'</div>'
      +'<div style="font-size:11px;color:var(--muted)">'+mt+' task'+(mt!==1?'s':'')+'</div>'
      +'<button class="btn btn-danger btn-sm" onclick="removeMember('+m.id+')">Remove</button>'
      +'</div>';
  }).join('');
}

// ── EXPORT CSV ────────────────────────────────────────────────────────────────
function exportCSV(){
  var headers=['Name','Department','Task','Priority','Status','Deadline','Progress %','Files'];
  var rows=TASKS.map(function(t){
    var m=getMember(t.memberId);
    return [m.name,t.dept,t.title,t.prio,t.status,t.deadline||'',t.progress,(t.files||[]).join('; ')].map(function(v){return '"'+String(v).replace(/"/g,'""')+'"'}).join(',');
  });
  var csv=[headers.join(',')].concat(rows).join('\n');
  var a=document.createElement('a');
  a.href='data:text/csv;charset=utf-8,'+encodeURIComponent(csv);
  a.download='RnD_Tasks_'+today+'.csv';
  a.click();
  toast('Exported CSV',true);
}

// ── NAVIGATION ────────────────────────────────────────────────────────────────
function showView(id,btn){
  document.querySelectorAll('.view').forEach(function(v){v.classList.remove('active')});
  document.querySelectorAll('.nav-item').forEach(function(n){n.classList.remove('active')});
  document.getElementById('view-'+id).classList.add('active');
  if(btn)btn.classList.add('active');
  renderAll();
}

function closeModal(id){document.getElementById(id).classList.remove('open');}

document.querySelectorAll('.modal-overlay').forEach(function(m){
  m.addEventListener('click',function(e){if(e.target===m)m.classList.remove('open')});
});

function globalSearch(v){renderAll();}

// ── RENDER ALL ────────────────────────────────────────────────────────────────
function renderAll(){
  renderStats();
  renderOverdue();
  renderDeptGrid();
  renderRecent();
  renderPeopleGrid();
  renderTasksTable();
  renderDeptDetail();
  renderUploads();
}

populateSelects();
renderAll();
</script>
</body>
</html>